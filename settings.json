  "org.todoKeywords": [
    "TODO",
    "DONE",
    "WAIT",
    "FIXME",
    "CANCEL"
  ],
  "todohighlight.isEnable": true,
  "todohighlight.isCaseSensitive": true,
  "todohighlight.keywords": [
    {
      "text": "DEBUG",
      "color": "#ffffff",
      "backgroundColor": "#5e81ac",
      "borderRadius": "2px",
      "overviewRulerColor": "#5e81ac"
    },
    {
      "text": "REVIEW",
      "color": "#2e3440",
      "backgroundColor": "#88c0d0",
      "borderRadius": "2px",
      "overviewRulerColor": "#88c0d0"
    },
    {
      "text": "DONE",
      "color": "#ffffff",
      "backgroundColor": "#a3be8c",
      "borderRadius": "2px",
      "overviewRulerColor": "#a3be8c"
    },
    {
      "text": "NOTE",
      "color": "#2e3440",
      "backgroundColor": "#ebcb8b",
      "borderRadius": "2px",
      "overviewRulerColor": "#ebcb8b"
    },
    {
      "text": "HACK",
      "color": "#ffffff",
      "backgroundColor": "#b48ead",
      "borderRadius": "2px",
      "isWholeLine": false,
      "overviewRulerColor": "#b48ead"
    },
    {
      "text": "FIXME",
      "color": "#ffffff",
      "backgroundColor": "#bf616a",
      "borderRadius": "2px",
      "overviewRulerColor": "#bf616a"
    },
    {
      "text": "TODO",
      "color": "#ffffff",
      "backgroundColor": "#d08770",
      "borderRadius": "2px",
      "overviewRulerColor": "#d08770"
    }
  ],
  "todohighlight.keywordsPattern": "",
  "todohighlight.defaultStyle": {
    "color": "#ffffff",
    "backgroundColor": "#81a1c1",
    "overviewRulerColor": "#81a1c1",
    "cursor": "pointer",
    "borderRadius": "2px",
    "isWholeLine": false
  },
  "todohighlight.include": [
    "**/*.js",
    "**/*.jsx",
    "**/*.ts",
    "**/*.tsx",
    "**/*.html",
    "**/*.php",
    "**/*.css",
