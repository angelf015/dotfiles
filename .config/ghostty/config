window-decoration              = true
macos-option-as-alt            = false
macos-titlebar-style           = tabs
background-opacity             = 0.95
background-blur-radius         = 20

#font-family                    = DankMono Nerd Font
#font-family-bold               = DankMono Nerd Font
#font-family-italic             = DankMono Nerd Font
#font-family-bold-italic        = DankMono Nerd Font
font-family                    = FiraCode Nerd Font
font-family-bold               = FiraCode Mono Nerd Font
font-family-italic             = FiraCode Mono Nerd Font
font-family-bold-italic        = FiraCode Mono Nerd Font

font-size                      = 17
window-inherit-font-size       = true

# Look and Feel
adjust-cursor-thickness        = 3
adjust-underline-position      = 3
bold-is-bright                 = true
cursor-invert-fg-bg            = true
cursor-opacity                 = 0.8
link-url                       = true
mouse-hide-while-typing        = true
theme                          = nord
window-vsync                   = true

# Other
clipboard-paste-protection     = true
clipboard-trim-trailing-spaces = true
copy-on-select                 = true
macos-auto-secure-input        = false
macos-secure-input-indication  = false
quit-after-last-window-closed  = true
scrollback-limit               = 4200
shell-integration              = zsh
shell-integration-features     = cursor,sudo,title


background-opacity = 0.95
background-blur-radius = 20

window-padding-color = extend
window-step-resize = true
window-padding-balance = true


### Mac Alt Fix
##macos-option-as-alt = left

keybind = alt+left=unbind
keybind = alt+right=unbind

### KeyBindings
# Toggle commands
keybind = global:alt+f=toggle_quick_terminal
keybind = alt+z=toggle_split_zoom

# Split Management
keybind = alt+v=new_split:right
keybind = alt+d=new_split:down

# Resize Split
keybind = ctrl+shift+j=resize_split:up,10
keybind = ctrl+shift+k=resize_split:down,10
keybind = ctrl+shift+h=resize_split:left,10
keybind = ctrl+shift+l=resize_split:right,10

# Navigation
keybind = alt+k=goto_split:up
keybind = alt+j=goto_split:down
keybind = alt+h=goto_split:left
keybind = alt+l=goto_split:right

# Miscellaneous
keybind = cmd+k=clear_screen

# Use it by writing 'nvim' first and then the keybinding to open the file with nvim
keybind = alt+s=write_screen_file:paste
